APP_ENV=development
APP_NAME=JalWatch API
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./jalwatch_dev.db
# For PostgreSQL, use: postgresql+psycopg2://user:password@localhost:5432/jalwatch
SECRET_KEY=jalwatch-insecure-dev-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_ORIGIN=http://localhost:5173
DEMO_MODE=true
DEVICE_INGESTION_ENABLED=true
IMIS_INTEGRATION_ENABLED=false
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
